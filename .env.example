# Server-only Supabase credentials. Never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Public canonical URL used in generated PDFs and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional anti-spam integration. The MVP includes a honeypot and timing check.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Salt for one-way hashing of visitor IPs (privacy). Set a long random value in production.
IP_HASH_SALT=

# Local development only: allows demo mode (no persistence) when Supabase vars are absent.
# Never set this in production.
ALLOW_DEMO_MODE=

# Server-only OpenAI credential for AI-assisted detailed report generation.
# The route falls back to a deterministic report if this is absent.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
